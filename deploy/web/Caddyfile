# Static file server of the web image (deploy/web/Dockerfile). No TLS, no admin API, no logs: the VM's Caddy is the
# public edge and sets the security headers; this one only picks the cache policy and the single-page fallback.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	# No access log (AGENTS.md, security rule 4).
	log_skip

	# The page that reads the invite code from the URL fragment is never stored by a cache (#27 SEC-9).
	@page path / /index.html /invite
	header @page Cache-Control "no-store"
	# Everything else is revalidated: the bundle files have no content hash in their names.
	header Cache-Control "no-cache"

	# /invite and any other client route are answered by the app's single page.
	try_files {path} /index.html
	file_server
}
