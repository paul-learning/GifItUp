# GifItUp site block for the VM's existing Caddyfile (docs/ops/vm-setup.md, ADR-0005).
# Replace gifitup.example.com with the real hostname on the VM only: the domain is not committed (public repo).
gifitup.example.com {
	# No access log on purpose: logs must not map users to IPs (CLAUDE.md, security rule 4).
	log_skip
	# Coarse cap for now. Encrypted blob uploads (M3, ADR-0003) need a per-route limit; the server's limit is authoritative.
	request_body {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# API only for now; the web app (#27) needs its own CSP.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-Via
	}
	# Android App Links (ADR-0013, #17 PR 4): Android fetches this one file over https, with no redirect, to verify that
	# the app may open https://<host>/invite. Answered here, not by the server: it is static and public. Replace the
	# fingerprint on the VM with the SHA-256 of the release signing certificate (docs/ops/deploy.md, "App Links"); it is
	# not secret, but it is only known once the release key exists, so it is not committed.
	handle /.well-known/assetlinks.json {
		header Content-Type "application/json"
		header Cache-Control "public, max-age=3600"
		respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"app.gifitup","sha256_cert_fingerprints":["REPLACE_WITH_RELEASE_SHA256"]}}]` 200
	}
	handle {
		# /ws is a WebSocket (ADR-0015): reverse_proxy upgrades it by default and sets no idle timeout of its own (the
		# server pings every 25 s). stream_close_delay keeps open sockets across a Caddy config reload of the shared VM
		# (the default closes them at once); clients reconnect anyway, so this only avoids a needless burst.
		reverse_proxy gifitup-server:8080 {
			stream_close_delay 5m
		}
	}
}
