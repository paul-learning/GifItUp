# Copy to /opt/gifitup/deploy/.env on the VM (gitignored). No secrets here: the Postgres password is in
# secrets/postgres_password (see docs/ops/vm-setup.md).

# Server image from the deploy workflow (#7), pinned to a commit SHA.
GIFITUP_SERVER_IMAGE=ghcr.io/paul-learning/gifitup-server:<commit-sha>
