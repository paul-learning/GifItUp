# Copy to /opt/gifitup/deploy/.env on the VM (gitignored). No secrets here: the Postgres passwords are in
# secrets/ (see docs/ops/vm-setup.md).

# Public base URL: deploy.sh's post-deploy health check, and the server's own origin that device signatures are checked
# against (ADR-0009). Canonical form only: https://, lowercase host, optional port other than 443, no trailing slash.
GIFITUP_PUBLIC_URL=https://gifitup.example.com

# Server image by digest. Written by deploy.sh on every deploy; don't edit by hand.
GIFITUP_SERVER_IMAGE=ghcr.io/paul-learning/gifitup-server@sha256:<digest>
