# Copy to /opt/gifitup/deploy/.env on the VM (gitignored). No secrets here: the Postgres password is in
# secrets/postgres_password (see docs/ops/vm-setup.md).

# Public base URL, used by deploy.sh for the post-deploy health check (docs/ops/deploy.md).
GIFITUP_PUBLIC_URL=https://gifitup.example.com

# Server image by digest. Written by deploy.sh on every deploy; don't edit by hand.
GIFITUP_SERVER_IMAGE=ghcr.io/paul-learning/gifitup-server@sha256:<digest>
